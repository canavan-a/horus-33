<?xml version="1.0" encoding="utf-8"?>
<!-- The ic_launcher_foreground eye for the ember theme. The eye's lines take the
     gradient of the super-chat logo's lettering in the same theme; the pupil
     is the theme accent (colors in values/ic_launcher_themes.xml). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.6"
        android:scaleY="0.6">
        <path
            android:strokeWidth="22"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M40,256 C136,140 376,140 472,256 C376,372 136,372 40,256 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="40" android:startY="256"
                    android:endX="472" android:endY="256"
                    android:startColor="@color/ic_eye_start_ember"
                    android:centerColor="@color/ic_eye_mid_ember"
                    android:endColor="@color/ic_eye_end_ember" />
            </aapt:attr>
        </path>
        <path
            android:strokeWidth="22"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M178,256 a78,78 0 1,0 156,0 a78,78 0 1,0 -156,0">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="40" android:startY="256"
                    android:endX="472" android:endY="256"
                    android:startColor="@color/ic_eye_start_ember"
                    android:centerColor="@color/ic_eye_mid_ember"
                    android:endColor="@color/ic_eye_end_ember" />
            </aapt:attr>
        </path>
        <path
            android:fillColor="@color/ic_pupil_ember"
            android:pathData="M220,256 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />
    </group>
</vector>
